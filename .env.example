# ═══════════════════════════════════════════════════════
# Pin Desk — Environment Variables
# Copy this file to .env and fill in ALL values
# ═══════════════════════════════════════════════════════

# ─── App ───────────────────────────────────────────
NODE_ENV=production
PORT=3000
APP_PORT=3000                    # Docker compose host port mapping

# ─── Database (PostgreSQL) ──────────────────────────
# Used directly by docker-compose to build DATABASE_URL for the app/worker —
# keep these in sync if you change them.
POSTGRES_USER=pindesk
POSTGRES_PASSWORD=change-me-to-a-random-password
POSTGRES_DB=pindesk
# Full connection string. When running via docker-compose this is built
# automatically from the POSTGRES_* vars above — only set this yourself if
# you're running the app OUTSIDE docker-compose (e.g. local `npm run dev`
# against `postgresql://pindesk:change-me...@localhost:5432/pindesk`).
DATABASE_URL=postgresql://pindesk:change-me-to-a-random-password@localhost:5432/pindesk

# ─── Redis (BullMQ job queue + per-account publish locks) ──
REDIS_URL=redis://localhost:6379
# How many pins the worker publishes in parallel ACROSS DIFFERENT accounts.
# Per-account pacing is enforced separately by a Redis lock, not by this.
# 2GB-stack default: 25 (single worker replica ≈ 40k+ pins/hour capacity).
# Only raise (and add worker replicas + RAM) on a bigger VPS.
WORKER_CONCURRENCY=25
# Redis memory cap (queue jobs + locks). noeviction is set in docker-compose —
# if Redis ever hits this cap, job writes fail VISIBLY instead of silently
# dropping scheduled pins. 384mb ≈ 300k+ pending jobs (~1.2KB each).
# SIZING RULE: pending pins × ~1.2KB. If you raise this, also raise the redis
# container memory limit (docker-compose) to ~1.5× this value.
REDIS_MAXMEMORY=384mb

# ─── 48-hour scheduling horizon (Postgres = source of truth) ────────
# ALL future scheduled pins live in PostgreSQL. Redis/BullMQ only holds jobs
# for pins due within this window; the worker's recurring dispatcher enqueues
# pins as they slide into it. This bounds Redis memory to ~horizon worth of
# pending jobs instead of months/years of them.
SCHEDULING_HORIZON_HOURS=48
# How often the dispatcher cycle runs (ms). Every cycle: recovers orphaned
# publishing pins, resumes plan/quota-paused pins, atomically claims
# undispatched in-window pins (FOR UPDATE SKIP LOCKED — safe across replicas)
# and re-ensures due pins have live jobs (Redis data-loss recovery).
DISPATCH_INTERVAL_MS=30000
# Pins claimed (atomically) per dispatcher cycle / total per cycle.
DISPATCH_BATCH=500
MAX_DISPATCH_PER_CYCLE=2000
# Due-sweep chunking (pins per DB query chunk / max chunks per cycle).
DISPATCH_SWEEP_CHUNK=500
MAX_SWEEP_CHUNKS=4
# Soft time budget for one dispatcher cycle (ms) — cycles yield early.
DISPATCH_CYCLE_BUDGET_MS=10000
# A publish job firing this much BEFORE the pin's scheduledFor is re-deferred
# (Postgres is the source of truth for WHEN), never published early.
EARLY_GRACE_MS=60000

# ─── Data Retention (worker's daily auto-purge job) ─────────────
# Keeps a small VPS disk (e.g. 35GB) from filling up. CSV files are never
# written to disk (uploads are parsed in memory) — these purge the DATABASE:
#   PIN_RETENTION_DAYS    — published/canceled/failed pins kept this long
#                           (queued/paused pins are NEVER deleted)
#   IMPORT_RETENTION_DAYS — CSV import batches + rows kept this long
#   API_LOG_RETENTION_DAYS— Pinterest API call log kept this long
#   AUDIT_LOG_RETENTION_DAYS — admin audit trail kept this long
# 14/7/7 keeps a 3300-account setup at ~10-20GB steady state. If you need
# longer analytics history, raise PIN_RETENTION_DAYS and add disk.
PIN_RETENTION_DAYS=14
IMPORT_RETENTION_DAYS=7
API_LOG_RETENTION_DAYS=7
AUDIT_LOG_RETENTION_DAYS=60
# Worker logs a warning (and reports on /health) when the disk passes this %
DISK_WARN_PERCENT=80

# ─── Session ───────────────────────────────────────
SESSION_SECRET=change-me-to-a-random-secret-string

# ─── Email (Resend — password reset OTP) ───────────
# Get this from https://resend.com/api-keys after connecting your domain
RESEND_API_KEY=
EMAIL_FROM=Pin Desk <noreply@pindesk.xyz>

# ─── Pinterest OAuth & API ──────────────────────
# Get these from https://developers.pinterest.com/
# 1. Create an app at Pinterest Developer Portal
# 2. Set Redirect URI to: https://your-domain.com/api/pinterest/callback
# 3. Request scopes: boards:read, boards:write, pins:read, pins:write, user_accounts:read
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=
PINTEREST_API_BASE=https://api.pinterest.com/v5
PINTEREST_REDIRECT_URI=

# ─── Payment — TRC20 USDT ──────────────────────────
TRON_WALLET_ADDRESS=
TRONSCAN_API_KEY=

# ─── Payment — Binance Pay ─────────────────────────
BINANCE_PAY_ID=

# ─── Admin Account (created on first deploy) ──────
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-now

# ─── Basic Auth (optional — site-wide protection) ──
# If both are set, entire site requires HTTP Basic Auth
BASIC_AUTH_USER=
BASIC_AUTH_PASS=



# ─── Capacity / security tuning (all optional) ─────
# Prisma connection pool: web app, and per worker replica. Keep
# DB_POOL_SIZE + (worker replicas × WORKER_DB_POOL) below Postgres
# max_connections (60 in docker-compose). Defaults 10 + 15 = 25.
DB_POOL_SIZE=10
WORKER_DB_POOL=15
# Reverse proxies in front of the app (Coolify/Traefik = 1; Cloudflare + Traefik = 2)
TRUSTED_PROXY_COUNT=1
# Payment TXIDs older than this are rejected (hours)
PAYMENT_TX_MAX_AGE_HOURS=48

# ─── Worker control & safety (added in audit) ───────────────────
# POST /trigger and /purge on the worker (port 3001, internal only) are DISABLED unless this is
# set; callers must then send it as the `x-worker-token` header. Generate: openssl rand -hex 24
WORKER_CONTROL_TOKEN=
# NEVER set to true in production: lets the app/worker fake "published" pins for demo connections.
ALLOW_SIMULATED_PINS=false
